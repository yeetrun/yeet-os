#!/usr/bin/env python3
"""Verify a unified Yeet release, upload its files, then mark it latest."""

import argparse
import hashlib
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
REPO = "yeetrun/yeet-os"
sys.dont_write_bytecode = True
sys.path.insert(0, str(ROOT / "installer"))
from update import PARTS, asset, validate


def digest(path):
    with path.open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def release_files(directory, version):
    files = {}

    def add(name, expected=None):
        actual = digest(directory / name)
        if expected is not None and expected != actual:
            raise ValueError(f"{name} checksum differs")
        files[name] = "sha256:" + actual

    def checked(name, checksum_file):
        sha, filename = (directory / checksum_file).read_text().strip().split()
        if filename != name:
            raise ValueError(f"{checksum_file} must identify {name}")
        add(name, sha)
        add(checksum_file)

    checked("yeet-os-installer.iso", "SHA256SUMS")
    add("install.sh", digest(ROOT / "yeet/install.sh"))
    for os_name in ("darwin", "linux"):
        for arch in ("amd64", "arm64"):
            name = f"yeet-{os_name}-{arch}.tar.gz"
            checked(name, name + ".sha256")
    for system in ("x86_64-linux", "aarch64-linux"):
        name = f"yeet-os-{system}.json"
        manifest = json.loads((directory / name).read_text())
        validate(manifest, system)
        if manifest["version"] != version:
            raise ValueError(f"{name} has the wrong release version")
        add(name)
        for part in PARTS:
            add(asset(part, system), manifest[part]["sha256"])
    return files


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("directory", type=Path)
    parser.add_argument("notes", type=Path)
    parser.add_argument("--check", action="store_true", help="verify local files only")
    args = parser.parse_args()
    version = (ROOT / "VERSION").read_text().strip()
    tag = "v" + version
    files = release_files(args.directory, version)
    print(f"Verified {len(files)} release files for {tag}.", flush=True)
    if args.check:
        return
    gh = ["gh", "release"]
    repo = ["--repo", REPO]
    flags = ["--json", "isDraft,assets"]
    view = [*gh, "view", tag, *repo, *flags]
    result = subprocess.run(view, capture_output=True, text=True)
    if result.returncode:
        subprocess.run([*gh, "create", tag, *repo, "--verify-tag", "--draft",
                        "--title", f"Yeet {tag}", "--notes-file", args.notes], check=True)
    elif not json.loads(result.stdout)["isDraft"]:
        sys.exit(f"{tag} is already public")
    subprocess.run([*gh, "upload", tag, *repo, "--clobber",
                    *(args.directory / name for name in files)], check=True)
    draft = json.loads(subprocess.check_output(view))
    if not draft["isDraft"] or {a["name"]: a["digest"] for a in draft["assets"]} != files:
        sys.exit("Draft assets differ from the verified files")
    subprocess.run([*gh, "edit", tag, *repo, "--draft=false", "--latest"], check=True)


if __name__ == "__main__":
    main()
